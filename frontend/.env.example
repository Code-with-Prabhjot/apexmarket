# Explicit opt-in only. Never silently replaces a failed live connection.
NEXT_PUBLIC_MOCK_FALLBACK=false
APEX_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/telemetry
# Server-only credentials; never use NEXT_PUBLIC_ for secrets.
APEX_CLIENT_API_KEY=
# Supply the admin key in the dashboard for sandbox settlement and chaos actions.
# This is verified by the backend; it is not stored in the browser.
