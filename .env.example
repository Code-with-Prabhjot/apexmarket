# =============================================================================
# ApexMarket: Empirical Multi-Provider Inference Arbitrage & Verified Escrow Settlement Engine
# Environment Configuration Template (Zero Secrets - Safe Defaults)
# Copy this file to .env and replace placeholders with real keys in local/production.
# =============================================================================

# Application Runtime
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Mission Control sandbox admin actions (disabled until a key is configured)
ADMIN_API_KEY=
DEMO_CHAOS_ENABLED=false
DEMO_MOCK_PROVIDER_URL=http://127.0.0.1:9002

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=apexmarket
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_secure_postgres_password@127.0.0.1:5432/apexmarket

# Redis Configuration (Redis 7)
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_URL=redis://:replace_with_secure_redis_password@127.0.0.1:6379/0

# Nebius Token Factory (Reference Anchor & Verification Judge)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_ANCHOR_MODEL_ID=nvidia/nemotron-3-nano-30b-a3b
NEBIUS_JUDGE_MODEL_ID=nvidia/nemotron-4-340b-instruct

# Secondary / Benchmark Providers (For Spot & Arbitrage Execution)
SECONDARY_API_KEY=your_secondary_api_key_here
SECONDARY_BASE_URL=https://openrouter.ai/api/v1
BENCHMARK_MODEL_ID=nvidia/nemotron-3-nano-30b-a3b

# PayPal Agentic Commerce (Orders v2 Vaulting & Mass Payouts v1)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Security & Attestation
HMAC_SECRET_KEY=replace_with_64_char_secure_random_hex_string_for_attestations

# Financial & Settlement Policies (Micro-Dollars: $1.00 = 1,000,000 micros)
DEFAULT_HOURLY_SPEND_LIMIT_MICROS=50000000
MIN_PAYOUT_THRESHOLD_MICROS=10000000
PROBATION_ESCROW_DAYS=7
PLATFORM_TAKE_RATE_BPS=1000
CANARY_OVERHEAD_RATE=0.04
ANCHOR_AUDIT_RATE=0.05
